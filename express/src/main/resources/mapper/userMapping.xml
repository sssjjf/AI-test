<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org/DTD Mapper 3.0" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.dao.UserDao">
    <select id="getUserByMessage" resultType="com.example.demo.bean.User">
        SELECT * FROM user WHERE username=#{username} AND password=#{password}
    </select>

    <insert id="register" >
        INSERT INTO user(username,password,role,e_mail,phone) VALUES(#{username},#{password},#{role},null,null);
    </insert>

    <insert id="addUser" >
        INSERT INTO user(username,password,role,e_mail,phone) VALUES(#{username},#{password},#{role},#{e_mail},#{phone});
    </insert>

    <delete id="deleteUser">
        DELETE FROM user WHERE username=#{username}
    </delete>

    <select id="getUserList" resultType="com.example.demo.bean.User">
        SELECT * FROM user
    </select>

    <select id="getUser" resultType="com.example.demo.bean.User">
        SELECT * FROM user WHERE username=#{username}
    </select>

    <update id="updateUser" >
        UPDATE user
        <set>
            <if test="user.password!=null">
                password = #{user.password},
            </if>
            <if test="user.role!=null">
                role = #{user.role},
            </if>
            <if test="user.e_mail!=null">
                e_mail = #{user.e_mail},
            </if>
            <if test="user.phone!=null">
                phone = #{user.phone},
            </if>
        </set>
         WHERE username = #{user.username}
    </update>

</mapper>